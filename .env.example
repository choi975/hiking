# Copy this file to .env, fill only the keys you want, then restart server.mjs.
# Never paste these values into the chat.

# Visual Crossing
# Free: 1,000 weather records/day, no credit card required.
# Page: https://www.visualcrossing.com/sign-up
VISUAL_CROSSING_KEY=

# Weatherbit
# Free: 50 requests/day, future 7-day daily forecast, non-commercial use.
# Page: https://www.weatherbit.io/account/create
WEATHERBIT_KEY=

# Seniverse / 心知天气
# Permanent free plan: future 3-day forecast, 100,000 requests/month, city-level.
# Use the private key ("key"), not the public uid.
# Page: https://www.seniverse.com/pricing
SENIVERSE_KEY=

# WeatherAPI.com
# Free plan after the 7-day Business trial: future 3-day forecast, 100,000 calls/month.
# Page: https://www.weatherapi.com/signup.aspx
WEATHERAPI_KEY=
